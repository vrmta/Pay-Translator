{
  "name": "wireswitch",
  "version": "1.1.3",
  "description": "WireSwitch client: sign payment intents locally (Ed25519) and POST them to a protocol-translation hop.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wireswitch",
    "payments",
    "protocol-translator",
    "ap2",
    "x402",
    "stripe",
    "ed25519",
    "sdk"
  ],
  "author": "Varun M",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "homepage": "https://wireswitch.io",
  "bugs": "https://github.com/vrmta/wireswitch/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/vrmta/wireswitch.git"
  }
}
